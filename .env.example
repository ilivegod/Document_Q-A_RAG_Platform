POSTGRES_USER=docqa
POSTGRES_PASSWORD=docqa123
POSTGRES_DB=docqa_db
# Host access when Postgres is exposed on port 5433 (docker compose)
DATABASE_URL=postgresql+asyncpg://docqa:docqa123@localhost:5433/docqa_db
REDIS_URL=redis://localhost:6379/0

# Required — Gemini (AIza… from https://aistudio.google.com/apikey)
GOOGLE_API_KEY=your_google_api_key_here

# Required for lead discovery (Places API enabled in Google Cloud)
GOOGLE_PLACES_API_KEY=

JWT_SECRET=your_random_secret_here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=30
CORS_ORIGINS=http://localhost:3000
FRONTEND_URL=http://localhost:3000

# Auth emails + closed beta approval (Resend — not required for in-app outreach in MVP A)
RESEND_API_KEY=
EMAIL_FROM=onboarding@resend.dev
PASSWORD_RESET_TTL_MINUTES=30
EMAIL_VERIFICATION_TTL_HOURS=24

# Closed beta (default on): approve signups via email before login
CLOSED_BETA_ENABLED=true
ADMIN_EMAIL=you@example.com
ADMIN_APPROVAL_TTL_DAYS=7
API_PUBLIC_URL=http://localhost:8000

# Document storage — required in production (local dev can use empty bucket + disk fallback)
R2_BUCKET_NAME=
R2_ENDPOINT_URL=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional: Sentry (leave empty to disable)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0

# Optional: Stripe Pro billing (hidden during beta)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID_PRO=
STRIPE_WEBHOOK_SECRET=

# MCP web research (DuckDuckGo + Wikipedia stdio servers)
MCP_WEB_ENABLED=false
MCP_DDG_COMMAND=python
MCP_DDG_ARGS=-m,duckduckgo_mcp.server
# Wikipedia MCP: use `wiki-mcp` in Docker (pre-installed); use npx locally if needed
MCP_WIKI_COMMAND=wiki-mcp
MCP_WIKI_ARGS=
# Local dev without global wiki-mcp: MCP_WIKI_COMMAND=npx  MCP_WIKI_ARGS=-y,wiki-mcp
MCP_TOOL_TIMEOUT_SECONDS=45
WEB_RESEARCH_MAX_RESULTS=5

# Prospecting — outreach domain/send deferred in MVP A; limit applies when re-enabled
OUTREACH_DAILY_SEND_LIMIT=20
